<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.athamu.app">
  <uses-permission android:name="android.permission.INTERNET"/>
  <application android:supportsRtl="true" android:label="ATHAMU" android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
    <activity android:exported="true" android:name=".MainActivity" android:configChanges="orientation|screenSize|keyboardHidden">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
